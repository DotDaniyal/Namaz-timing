# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_SESSION_SECRET: Secret key used to sign HTTP-only administrator session cookies.
ADMIN_SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# ADMIN_INITIAL_USERNAME: Initial administrator username seeded on first startup.
ADMIN_INITIAL_USERNAME="admin"

# ADMIN_INITIAL_PASSWORD: Initial administrator password seeded on first startup (change after login).
ADMIN_INITIAL_PASSWORD="ChangeMeInAdminPanel!"
